
# Local agent harness (per-developer, not committed) — but CI/CD workflows ARE
# project infrastructure and must be versioned:
# (gitignore can't re-include under a directory-level ignore, so we ignore the
# contents and carve out workflows/)
.github/*
!.github/workflows/
.vscode/
.venv/

# Design skill staging (local working copies)
design/refs/

# Environment files with secrets (keep only .env.example)
.env
*.env
!.env.example

# Node / frontend
node_modules/
dist/
*.local

# Test output
coverage/
playwright-report/
test-results/
