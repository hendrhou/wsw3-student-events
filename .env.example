# Campus Pulse — compose environment (dev defaults, no real secrets)
# NOTE: port 5000 is taken by macOS AirPlay Receiver — the shell uses 3000.
SHELL_PORT=3000
EVENTS_MFE_PORT=5001
PARTICIPATION_MFE_PORT=5002
CREDENTIALS_MFE_PORT=5003
PEOPLE_MFE_PORT=5004
# Kong publishes on port 80 by default → port-free URLs (http://localhost,
# http://student.localhost, …). If port 80 is taken on your machine, set
# KONG_PORT=8000 and adjust the public URLs to match (e.g. http://localhost:8000/api).
KONG_PORT=80
PUBLIC_GATEWAY_URL=http://localhost/api
PUBLIC_BASE_URL=http://localhost

# Grafana admin sign-in (observability UI, via Kong at grafana.localhost). Dev
# defaults; change if exposing.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Local-only event cover storage. Change these if exposing the compose stack.
MINIO_ROOT_USER=campus-pulse
MINIO_ROOT_PASSWORD=dev-minio-change-me

# Auth — leave EMPTY locally (dev-login is enabled instead). In CI these come
# from GitHub Secrets and land in AWS Secrets Manager, never in images.
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev-only login endpoint (POST /api/auth/dev-login). Never enable in prod.
ALLOW_DEV_LOGIN=true
# Comma-separated @ufp.edu.pt emails that become admins at startup.
# Admins grant/revoke organiser access from the organiser Team screen.
ADMIN_EMAILS=olga@ufp.edu.pt
