# Campus Pulse — compose environment (dev defaults, no real secrets)
# NOTE: port 5000 is taken by macOS AirPlay Receiver — the shell uses 3000.
SHELL_PORT=3000
STUDENT_MFE_PORT=5001
ORGANISER_MFE_PORT=5002
KONG_PORT=8000
FUSEKI_PORT=3030

# Auth — leave EMPTY locally (dev-login is enabled instead). In CI these come
# from GitHub Secrets and land in AWS Secrets Manager, never in images.
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev-only login endpoint (POST /api/auth/dev-login). Never enable in prod.
ALLOW_DEV_LOGIN=true
